MYSQL_DSN=asset_app:REPLACE_WITH_PASSWORD@tcp(127.0.0.1:3306)/asset_system
LISTEN_ADDR=127.0.0.1:3000
FRONTEND_DIR=/opt/asset-system/frontend
DB_MAX_OPEN=8
GOMEMLIMIT=384MiB
GOMAXPROCS=2
# Required only when initializing a completely empty users table.
ASSET_ADMIN_USERNAME=admin
ASSET_ADMIN_PASSWORD=REPLACE_WITH_12_OR_MORE_CHARACTERS
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# Register this exact callback in the application's SSO configuration.
SSO_ISSUER=https://sso.nineton.cn
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://xz.vodayapp.com/auth/oidc/callback
SSO_SCOPES="openid profile email"
# Only set after the SSO owner confirms this provider is enabled for the app.
SSO_PROVIDER_HINT=
# Only enable after verifying this issuer's immutable sub is the DingTalk user ID.
SSO_SUBJECT_IS_DINGTALK_USER_ID=0
# Separate Android origin, only if needed; Web and DingTalk use same-origin HTTPS.
ALLOWED_ORIGIN=https://localhost
