MYSQL_DSN=asset_app:REPLACE_WITH_PASSWORD@tcp(127.0.0.1:3306)/asset_system
LISTEN_ADDR=127.0.0.1:3000
FRONTEND_DIR=/opt/asset-system/frontend
DB_MAX_OPEN=8
GOMEMLIMIT=384MiB
GOMAXPROCS=2
# Required only when initializing a completely empty users table.
ASSET_ADMIN_USERNAME=admin
ASSET_ADMIN_PASSWORD=REPLACE_WITH_12_OR_MORE_CHARACTERS
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
# Separate Android origin, only if needed; Web and DingTalk use same-origin HTTPS.
ALLOWED_ORIGIN=https://localhost
